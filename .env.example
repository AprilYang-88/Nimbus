# Storage. Leave DATABASE_URL empty to use a local SQLite file (data/nimbus.db).
# Set it to a Supabase / Postgres connection string to use cloud Postgres instead.
# Supabase: Project Settings -> Database -> Connection string (use the pooler, port 6543).
DATABASE_URL=

# Optional. Nimbus works in local demo mode without an API key.
# Any OpenAI-compatible Chat Completions endpoint works (DeepSeek, 智谱 GLM, OpenAI, ...).
LLM_API_KEY=
# DeepSeek:  https://api.deepseek.com                 (model e.g. deepseek-v4-flash)
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4      (model e.g. glm-4-flash)
# OpenAI:    https://api.openai.com/v1                 (model e.g. gpt-4o-mini)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
